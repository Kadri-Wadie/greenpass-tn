# Copy this file to .env and fill in your own values.
# Never commit the real .env file — it stays in .gitignore.

# --- Hedera network -----------------------------------------------------
HEDERA_NETWORK=testnet

# Set true for a local-only demonstration without Hedera credentials.
# Set false to submit and verify real HCS messages on Hedera testnet.
DEMO_MODE=true

# --- Operator credentials (from https://portal.hedera.com/) -------------
# Account ID looks like 0.0.xxxxx
HEDERA_ACCOUNT_ID=0.0.xxxxx
# Private key as issued by the portal — DER-encoded or raw ECDSA/ED25519 hex.
# src/config/client.js tries all three formats automatically.
HEDERA_PRIVATE_KEY=302e020100300506032b657004220420...

# --- Hedera resources created by the one-time setup scripts --------------
# Fill these in after running `npm run create-topic` (and, later, any HTS setup).
HEDERA_TOPIC_ID=0.0.xxxxx
HEDERA_TOKEN_ID=0.0.xxxxx

# --- Mirror Node ----------------------------------------------------------
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# --- Server ----------------------------------------------------------------
PORT=3000
